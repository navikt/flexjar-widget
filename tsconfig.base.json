{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
  "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@navikt/flexjar-core": ["packages/flexjar-core/src"],
      "@navikt/flexjar-core/*": ["packages/flexjar-core/src/*"]
    }
  }
}
