    "@typescript-eslint/parser": "^7.18.0",
    "@testing-library/react": "^15.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-storybook": "^9.1.10",
    "jsdom": "^24.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
