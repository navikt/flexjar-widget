{
  "name": "@navikt/flexjar-widget",
  "version": "0.2.9",
  "description": "Aksel-based React widget for configurable NAV Flexjar surveys.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/navikt/flexjar-widget.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/**/*.css"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "test": "vitest run --passWithNoTests",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@navikt/ds-react": ">=5",
    "@navikt/nav-dekoratoren-moduler": ">=1.6.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@navikt/nav-dekoratoren-moduler": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^9.1.10",
    "@storybook/react-vite": "^9.1.10",
    "storybook": "^9.1.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@navikt/ds-css": "^5.0.0",
    "eslint-plugin-storybook": "9.1.10",
    "@storybook/addon-docs": "^9.1.10",
    "@navikt/nav-dekoratoren-moduler": "^1.6.9"
  },
  "keywords": [
    "nav",
    "flexjar",
    "survey",
    "react"
  ],
  "license": "MIT"
}
