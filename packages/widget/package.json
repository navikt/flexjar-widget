{
  "name": "@navikt/flexjar-widget",
  "version": "0.2.14-feature-context.3",
  "description": "Aksel-based React widget for configurable NAV Flexjar surveys.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./styles.css": "./dist/index.css"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/navikt/flexjar-widget.git"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/**/*.css"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsup --config tsup.config.ts",
    "test": "vitest run --passWithNoTests",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@navikt/ds-css": ">=7",
    "@navikt/ds-react": ">=7",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@navikt/nav-dekoratoren-moduler": {
      "optional": true
    }
  },
  "devDependencies": {
    "@navikt/ds-css": "^7.35.0",
    "@navikt/ds-react": "^7.35.0",
    "@storybook/addon-a11y": "^9.1.10",
    "@storybook/react-vite": "^9.1.10",
    "@types/node": "^24.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^9.1.10"
  },
  "keywords": [
    "nav",
    "flexjar",
    "survey",
    "react"
  ],
  "license": "MIT"
}