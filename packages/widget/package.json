{
  "name": "@navikt/flexjar-widget",
  "version": "0.1.0",
  "description": "Aksel-based React widget for configurable NAV Flexjar surveys.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./modal": {
      "types": "./dist/modal/index.d.ts",
      "import": "./dist/modal/index.js",
      "require": "./dist/modal/index.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "modal": ["dist/modal/index.d.ts"]
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
  "build": "tsup src/index.ts src/modal/index.ts --format esm,cjs --dts",
    "test": "vitest run --passWithNoTests",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@navikt/ds-react": ">=5",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^9.1.10",
    "@storybook/react-vite": "^9.1.10",
    "storybook": "^9.1.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@navikt/ds-css": "^5.0.0",
    "eslint-plugin-storybook": "9.1.10",
    "@storybook/addon-docs": "^9.1.10"
  },
  "keywords": [
    "nav",
    "flexjar",
    "survey",
    "react"
  ],
  "license": "MIT"
}
